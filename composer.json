{
    "name": "awssat/discord-notification-channel",
    "description": "Discord Notification Channel for laravel.",
    "keywords": [
        "laravel",
        "notifications",
        "discord"
    ],
    "license": "MIT",
    "authors": [
        {
            "name": "Bader Almutairi",
            "email": "phpfalcon@gmail.com"
        }
    ],
    "require": {
        "php": "^8.1",
        "guzzlehttp/guzzle": "^7.0",
        "illuminate/notifications": "^10.0|^11.0|^12.0|^13.0",
        "laravel/slack-notification-channel": "^3.2"
    },
    "require-dev": {
        "mockery/mockery": "^1.6",
        "phpunit/phpunit": "^10.1|^11.0|^12.0"
    },
    "autoload": {
        "psr-4": {
            "Awssat\\Notifications\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Awssat\\Tests\\Notifications\\": "tests/"
        }
    },
    "config": {
        "sort-packages": true
    },
    "extra": {
        "laravel": {
            "providers": [
                "Awssat\\Notifications\\DiscordChannelServiceProvider"
            ]
        }
    },
    "minimum-stability": "dev",
    "prefer-stable": true
}
